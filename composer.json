{
    "name": "vjackk/deployment-notifications",
    "description": "Deployment notifications",
    "type": "magento2-component",
    "version": "3.0.2",
    "license": "OSL-3.0",
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "Vjackk\\DeploymentNotifications\\": "/src"
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
